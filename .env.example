# Copy to .env. The API reads real environment variables; it does not load
# this file itself. docker compose loads .env automatically. For a local run use:
#   set -a; source .env; set +a
# Nothing in this file is required for the offline demo.

# Identity. `demo` trusts the user_id in the request body (the challenge payload;
# NOT authentication). `jwt` requires a bearer token signed with JWT_SECRET
# (32+ characters); the token subject is the customer and a body user_id must
# match it. Mint a development token with: python scripts/make_token.py cliente1988
AUTH_MODE=demo
# JWT_SECRET=
# JWT_ISSUER=
# JWT_AUDIENCE=

# Human operators. Leave unset to switch the /operator/* routes off.
# Use 24+ random characters. A shared key is a prototype; see the README.
# OPERATOR_API_KEY=

# Conversation memory (stored in the same SQLite file as tickets)
MEMORY_MESSAGES=8
SUMMARY_TRIGGER_MESSAGES=14
CONVERSATION_TTL_DAYS=30

# Agent behaviour
REPLAN_ENABLED=true
MAX_REPLANS=1
VERIFY_GROUNDING=true
VERIFY_MIN_SCORE=0.8
# VERIFY_MODEL=
QUERY_EXPANSION=true

# Optional cost estimate in the logs and /metrics, [input, output] USD per
# million tokens per model. Unset: tokens are counted but cost is not guessed.
# MODEL_PRICES_USD_PER_MTOK={"gemini-3.8-flash": [0.5, 3.0]}

# Evaluation (tests/agentic_eval.py)
# JUDGE_MODEL=

# Google AI Studio (Gemini) LLM. Not needed for the offline demo.
# GEMINI_API_KEY=AIza...
FAST_MODEL=gemini-3.8-flash
SMART_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# Knowledge base / crawler
SEED_URLS=https://site.getnet.com.br/get-ajuda/,https://site.getnet.com.br/get-ajuda-configuracoes/,https://site.getnet.com.br/get-ajuda-configuracoes/como-configurar-o-wi-fi-na-sua-maquininha-getnet/,https://site.getnet.com.br/get-ajuda-configuracoes/configuracoes-da-sua-maquininha/,https://site.getnet.com.br/get-ajuda-pix/,https://site.getnet.com.br/get-ajuda-pix/como-habilitar-pix-pelo-portal/,https://site.getnet.com.br/get-ajuda-pix/como-habilitar-o-recebimento-de-vendas-via-pix-no-aplicativo-getnet-brasil/,https://site.getnet.com.br/link-de-pagamento/,https://site.getnet.com.br/pix/,https://site.getnet.com.br/crediario/
ALLOWED_CRAWL_HOSTS=site.getnet.com.br
# The Docker image stores these on the /data volume. Uncomment only for a
# local run outside Docker.
# INDEX_FILE=index.json
INDEX_MAX_AGE_HOURS=168
CRAWL_MAX_PAGES=30
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_TEXT_CHARS=250000
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional web search. Not needed for the offline demo.
# TAVILY_API_KEY=tvly-...

# Support tickets / orchestration
# TICKET_DB_FILE=tickets.sqlite3
MAX_TOOL_ROUNDS=6
ESCALATE_ON_ANGRY=true
ESCALATION_CONFIDENCE_THRESHOLD=0.45
LOG_LEVEL=INFO